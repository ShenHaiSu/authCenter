# ============================================================================
# Caddyfile.example — AuthCenter 反代示例（后端架构文档 07 §5.3）
#
# AuthCenter 只监听 127.0.0.1:53779（HTTP，需求红线 C2/R2），
# 对外 HTTPS 一律由 Caddy 终结（自动申请/续期证书）。
# 复制本文件为 Caddyfile 并按实际域名修改后使用。
# ============================================================================

# 公网域名（Caddy 自动申请并续期 HTTPS 证书）
auth.example.com {
	reverse_proxy 127.0.0.1:53779

	# 可选加固（文档 06 §9）：
	# 固定 Host 头，防 Host 头注入
	# header_up Host {host}
	# 开启访问日志
	# log {
	#     output file /var/log/caddy/authcenter.log
	# }
}

# 局域网内网访问（自签证书，仅可信网络）
# auth.lan {
#     tls internal
#     reverse_proxy 127.0.0.1:53779
# }
